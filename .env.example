DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-id>.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:<password>@db.<project-id>.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_MAXLEN=100000
APP_ENV=development
API_AUTH_MODE=jwt
SECRET_KEY=<generate with: openssl rand -hex 32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
TASK_MAX_PAYLOAD_BYTES=65536
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_TIMEOUT_SECONDS=300
LEASE_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=30
WORKER_CONCURRENCY=10
SCHEDULER_TICK_SECONDS=5
SCHEDULER_LEADER_LOCK_TTL_SECONDS=30
RESULT_RETENTION_DAYS=30
TASK_EVENT_RETENTION_DAYS=90
DLQ_RETENTION_DAYS=180
METRICS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=<anon-key-from-supabase-dashboard>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-supabase-dashboard>
S3_ENDPOINT_URL=https://<project-id>.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=<from-supabase-storage>
S3_SECRET_ACCESS_KEY=<from-supabase-storage>
S3_BUCKET_NAME=task-payloads
RATE_LIMIT_BACKEND=redis
DEFAULT_RATE_LIMIT_RPS=100
APP_VERSION=0.1.0